# Aakash Dashboard configuration

# How the dashboard server reaches the emulator.
#   same machine:          http://localhost:4566
#   docker compose:        http://aakash:4566
AAKASH_ENDPOINT=http://localhost:4566

# Host/port shown in copyable connection strings and CLI snippets.
AAKASH_PUBLIC_HOST=localhost
AAKASH_PUBLIC_PROTOCOL=http
AAKASH_API_PORT=4566

# Host path for persistent emulator state.
AAKASH_HOST_DATA_PATH=./aakash-data

# Port ranges the console treats as reachable (match docker-compose.yml).
AAKASH_RDS_PORT_RANGE_START=7001
AAKASH_RDS_PORT_RANGE_END=7099
AAKASH_EC2_SSH_PORT_RANGE_START=2200
AAKASH_EC2_SSH_PORT_RANGE_END=2299
AAKASH_ELASTICACHE_PORT_RANGE_START=6379
AAKASH_ELASTICACHE_PORT_RANGE_END=6399

# Optional emulator admin paths (defaults match the bundled engine).
# AAKASH_BACKEND_HEALTH_PATH=/_floci/health
# AAKASH_BACKEND_RESET_PATH=/_floci/reset
# AAKASH_BACKEND_SES_MESSAGES_PATH=/_floci/ses/messages

# AWS client credentials for the emulator.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# AAKASH_EMULATOR_IMAGE=floci/floci:latest
