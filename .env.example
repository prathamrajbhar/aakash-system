# Aakash Management Dashboard Configuration

# 1. Backend Aakash API Connection (How Next.js server reaches Aakash internally)
# Local install / same machine: http://localhost:4566
# Docker compose same network: http://aakash:4566
# Remote Tailnet machine: http://100.64.0.10:4566
AAKASH_ENDPOINT=http://localhost:4566

# 2. Initial Network & Access Defaults (Can be configured dynamically from UI at /settings/network)
# Modes: local | lan | tailscale | custom
AAKASH_NETWORK_MODE=local
AAKASH_PUBLIC_HOST=localhost
AAKASH_PUBLIC_PROTOCOL=http
AAKASH_API_PORT=4566

# 3. Settings Lock & Storage Path
# Set to true to lock the network settings in read-only mode for centrally managed deployments
AAKASH_CONFIG_LOCKED=false
AAKASH_CONFIG_STORAGE_PATH=./data/aakash-ui-config.json
# Persistent host system path for S3, database backups, and emulator state
AAKASH_HOST_DATA_PATH=./aakash-data

# 4. Resource Proxy Port Ranges
AAKASH_RDS_PORT_RANGE_START=7001
AAKASH_RDS_PORT_RANGE_END=7099
AAKASH_EC2_SSH_PORT_RANGE_START=2200
AAKASH_EC2_SSH_PORT_RANGE_END=2299
AAKASH_ELASTICACHE_PORT_RANGE_START=6379
AAKASH_ELASTICACHE_PORT_RANGE_END=6399

# 5. Backend Admin Hooks (optional)
# The dashboard uses these to show live engine health, reset state, and read
# captured SES emails. Point them at your own engine's admin API.
# Defaults match the bundled emulator engine, so leave them unset unless you
# run a different backend.
# AAKASH_BACKEND_HEALTH_PATH=/_floci/health
# AAKASH_BACKEND_RESET_PATH=/_floci/reset
# AAKASH_BACKEND_SES_MESSAGES_PATH=/_floci/ses/messages

# 6. AWS Client Credentials for Aakash
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# 7. Docker Compose Emulator Image (optional)
# AAKASH_EMULATOR_IMAGE=floci/floci:latest

# Note: NODE_ENV is managed by Next.js (`next dev` / `next build` / `next start`).
# Do not set it here.
