# Aakash behind a Cloudflare Tunnel. Copy to .env and fill in.
# Used by: docker compose -f docker-compose.cloudflare.yml up -d --build
# Never commit the real .env: it holds the tunnel token.

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Create a dedicated tunnel for Aakash (Zero Trust > Networks > Tunnels > Create,
# connector "Docker") and paste its token. A separate tunnel keeps Aakash's routes
# away from any tunnel you already run.
TUNNEL_TOKEN=

# ── Hostnames (as added to the tunnel) ──────────────────────────────────────
# The hostname people type for the AWS API, e.g. api.example.com
AAKASH_API_HOSTNAME=
# Hostname for anonymous public file URLs, e.g. files.example.com (leave empty to disable)
AAKASH_FILES_HOSTNAME=

# ── Cloudflare Access (protects the dashboard) ──────────────────────────────
# Zero Trust > Access > Applications > Add > Self-hosted, for aakash.<domain>
# Team domain: shown under Settings > Custom Pages, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: open the application > Overview
CF_ACCESS_AUD=
# Optional second lock on top of the Access policy: comma-separated emails
AAKASH_ALLOWED_EMAILS=

# ── Optional ────────────────────────────────────────────────────────────────
# Extra access key IDs the API gateway accepts (keys from scripts/create-api-key.sh
# are picked up automatically, no need to list them here).
GATEWAY_ACCESS_KEY_IDS=
# Enable the dashboard's "Reset emulator state" button (wipes every resource).
AAKASH_ALLOW_RESET=false
# Where emulator state lives on this server.
AAKASH_HOST_DATA_PATH=./aakash-data
# AAKASH_EMULATOR_IMAGE=floci/floci:latest
